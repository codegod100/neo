load("//snowydeer:nix_build.bzl", "nix_build")

filegroup(
    name = "flake",
    srcs = glob([
        "flake.nix",
        "flake.lock",
    ]),
)

# Snowydeer realizes this on the same BuildBuddy execution platform as its
# consumers, making the pinned toolchain available to remote actions.
nix_build(
    name = "environment",
    attr = "neo-rbe-env",
    binaries = [
        "clippy-driver",
        "rustc",
        "rustdoc",
    ],
    flake = ":flake",
    visibility = ["PUBLIC"],
)
