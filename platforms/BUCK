load("@prelude//platforms:defs.bzl", "host_configuration")
load(":defs.bzl", "buildbuddy_execution_platform", "cache_execution_platform")

config_setting(
    name = "is-android-aarch64",
    constraint_values = [
        "prelude//os/constraints:os[android]",
        "prelude//cpu/constraints:cpu[arm64]",
    ],
)

config_setting(
    name = "is-android-x86_64",
    constraint_values = [
        "prelude//os/constraints:os[android]",
        "prelude//cpu/constraints:cpu[x86_64]",
    ],
)

platform(
    name = "android-aarch64",
    constraint_values = [
        "prelude//os/constraints:os[android]",
        "prelude//cpu/constraints:cpu[arm64]",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "android-x86_64",
    constraint_values = [
        "prelude//os/constraints:os[android]",
        "prelude//cpu/constraints:cpu[x86_64]",
    ],
    visibility = ["PUBLIC"],
)

# Same as prelude//platforms:default, plus remote cache read/write against
# BuildBuddy. Opt in via `execution_platforms = root//platforms:cache` in
# .buckconfig.local. See defs.bzl for why remote *execution* stays off.
cache_execution_platform(
    name = "cache",
    cpu_configuration = host_configuration.cpu,
    os_configuration = host_configuration.os,
    use_windows_path_separators = host_info().os.is_windows,
    visibility = ["PUBLIC"],
)

buildbuddy_execution_platform(
    name = "remote",
    cpu_configuration = host_configuration.cpu,
    container_image = "docker://ghcr.io/codegod100/neo-rbe@sha256:de02374ac0e8e7105a1abad21bd403e4db758fe2d2da9d1513705fb20775dc9c",
    os_configuration = host_configuration.os,
    use_windows_path_separators = host_info().os.is_windows,
    visibility = ["PUBLIC"],
)
